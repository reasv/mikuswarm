# MikuSwarm — Compose runtime secrets/vars. Copy to .env and fill in.
#   cp .env.example .env
# docker-compose injects these into the agent (and console) containers; the
# config loader substitutes ${VAR} references in the TOML at startup and FAILS
# FAST if any referenced var is missing.

# ── WHICH COMPOSE FILE? ──────────────────────────────────────────────────────
#   docker-compose.yml          build-from-source (current / dev). The maintainer's
#                               live deploy; builds every image locally.
#   docker-compose.ghcr.yml     FULL stack from PUBLISHED GHCR images (image-pull):
#                               agent + console + egress firewall + browser Manager
#                               + runtime sandbox. Becomes the default compose at
#                               release. Needs MIKUSWARM_IMAGE_PREFIX/TAG below.
#   docker-compose.minimal.yml  agent + console ONLY, image-pull. No firewall, no
#                               browser, no sandbox (reduced isolation — see that
#                               file's header). Simplest "copy + .env + up".
# Pick one and pass it with `-f`, e.g. `docker compose -f docker-compose.ghcr.yml up -d`.

# ── PUBLISHED-IMAGE SELECTION (ghcr.yml / minimal.yml) ───────────────────────
# Where the image-pull compose files fetch first-party images from, and which tag.
# Ignored by the build-based docker-compose.yml. The default prefix has a literal
# OWNER placeholder — set it to YOUR GitHub owner (registry+owner, no image name).
#   MIKUSWARM_IMAGE_PREFIX=ghcr.io/your-github-username
#   ⇒ pulls ${PREFIX}/mikuswarm-agent:${TAG}, -console, -egress, -sandbox
MIKUSWARM_IMAGE_PREFIX=ghcr.io/OWNER
MIKUSWARM_TAG=latest

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Referenced by the merged config (config/90-local.toml + docker/95-docker.toml),
# or by the compose file itself (the host-identity vars below).

# Host identity the agent + console containers run as (compose `user:`), so the
# SQLite DB (./var), workspace files (./workspaces/miku), and context dumps
# (./debug) are owned by YOUR user on the host, not root. The sandbox container
# inherits the same uid:gid at runtime. These are per-host values — re-derive
# them on every machine the folder is copied to. Compose fails fast (`:?`) when
# any of the three is unset.
#   MIKUSWARM_UID:   id -u
#   MIKUSWARM_GID:   id -g                                            (both ALWAYS required)
#   DOCKER_GID: stat -c %g /var/run/docker.sock
#     (group of the mounted docker socket — grants the non-root agent its one
#      privilege: talking to the daemon to create/exec the sandbox container.
#      REQUIRED for the build-based and ghcr.yml stacks. NOT needed for
#      docker-compose.minimal.yml — that stack mounts no socket / runs no sandbox.)
MIKUSWARM_UID=
MIKUSWARM_GID=
DOCKER_GID=

# Model provider API bases. These are native-provider endpoints (Anthropic-
# compatible chat, OpenAI-compatible chat, OpenRouter-compatible captioning,
# Google/Gemini image-gen). An operator may point them at one gateway that
# proxies all of them — that mapping is a deployment detail and stays here, not
# in committed config. LLM_API_KEY is the shared Bearer credential (use the
# same value for each if your gateway shares it).
ANTHROPIC_BASE_URL=https://api.example/anthropic
# Must end in /v1 — the OpenAI SDK appends /chat/completions to this base
# (native OpenAI is https://api.openai.com/v1).
OPENAI_BASE_URL=https://api.example/openai/v1
OPENROUTER_BASE_URL=https://api.example/openrouter
GEMINI_BASE_URL=https://api.example/google
LLM_API_KEY=

# Matrix login (this deployment uses password + recovery-key login; homeserver /
# user_id / device_id are inlined in 90-local.toml).
MATRIX_PASSWORD=
MATRIX_RECOVERY_KEY=

# Observability console bearer token. The console is ENABLED in the docker
# overlay, so this is required and must be non-blank (shared by agent + console).
MIKUSWARM_CONSOLE_TOKEN=

# Browser-use Manager bearer token. REQUIRED for the FULL stack (build-based or
# docker-compose.ghcr.yml): the CloakBrowser-Manager (`manager` service) is present
# and [browser] is enabled in 90-local.toml, so this gates every /api/* route on the
# Manager AND is what the agent sends as [browser].auth_token — the two MUST be the
# same value. Compose fails fast (`:?`) if unset. Generate one, e.g.
# `openssl rand -hex 32`. NOT needed for docker-compose.minimal.yml (no Manager,
# browser disabled) — if 90-local.toml still references it, set any non-blank value.
BROWSER_AUTH_TOKEN=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# SauceNAO reverse-image lookup API key (find_source tool). OPTIONAL: SauceNAO
# soft-disables when unset — the tool simply isn't registered, nothing fails. Set
# it (and reference ${SAUCENAO_API_KEY} from [saucenao] in local config) to enable.
# SAUCENAO_API_KEY=
#
# NOTE: web search/fetch runs through Exa's public MCP endpoint, which needs NO API
# key — it works out-of-box on a fresh deploy (config/00-defaults.toml [mcp.servers.exa]).
# Host port to publish the console on (container always listens on 5173).
MIKUSWARM_CONSOLE_PUBLISH=5173

# Public URL you open the console at in the browser. Must match scheme+host+port
# exactly, or SvelteKit 403s the resume/abort/retry buttons ("Cross-site remote
# requests are forbidden") while read-only views still work. Default suits the
# loopback case; change it if you set MIKUSWARM_CONSOLE_PUBLISH to another port, reach
# the console from another host, or put it behind an https reverse proxy.
MIKUSWARM_CONSOLE_ORIGIN=http://127.0.0.1:5173

# Set only if your 90-local.toml references them (e.g. if you switch the matrix
# account to ${MATRIX_*} placeholders instead of inlined literals).
# MATRIX_HOMESERVER=https://matrix.example
# MATRIX_USER_ID=@miku:example
# MATRIX_DEVICE_ID=mikuswarm
# MATRIX_ACCESS_TOKEN=

# Override the agent's timezone before config load (config's agent.timezone is
# authoritative once loaded).
# TZ=America/Chicago
