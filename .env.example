# MikuSwarm — Compose runtime secrets/vars. Copy to .env and fill in.
#   cp .env.example .env
# docker-compose injects these into the agent (and console) containers; the
# config loader substitutes ${VAR} references in the TOML at startup and FAILS
# FAST if any referenced var is missing.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Referenced by the merged config (config/90-local.toml + docker/95-docker.toml).

# Model provider API bases. These are native-provider endpoints (Anthropic-
# compatible chat, OpenRouter-compatible captioning, Google/Gemini image-gen). An
# operator may point them at one gateway that proxies all three — that mapping is
# a deployment detail and stays here, not in committed config. LLM_API_KEY is the
# shared Bearer credential (use the same value for each if your gateway shares it).
ANTHROPIC_BASE_URL=https://api.example/anthropic
OPENROUTER_BASE_URL=https://api.example/openrouter
GEMINI_BASE_URL=https://api.example/google
LLM_API_KEY=

# Matrix login (this deployment uses password + recovery-key login; homeserver /
# user_id / device_id are inlined in 90-local.toml).
MATRIX_PASSWORD=
MATRIX_RECOVERY_KEY=

# Observability console bearer token. The console is ENABLED in the docker
# overlay, so this is required and must be non-blank (shared by agent + console).
MIKUSWARM_CONSOLE_TOKEN=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Host port to publish the console on (container always listens on 5173).
MIKUSWARM_CONSOLE_PUBLISH=5173

# Set only if your 90-local.toml references them (e.g. if you switch the matrix
# account to ${MATRIX_*} placeholders instead of inlined literals).
# MATRIX_HOMESERVER=https://matrix.example
# MATRIX_USER_ID=@miku:example
# MATRIX_DEVICE_ID=mikuswarm
# MATRIX_ACCESS_TOKEN=

# Set only if you enable [browser] in 90-local.toml AND the Manager runs with an
# AUTH_TOKEN (see docker/docker-compose.browser.yml).
# BROWSER_AUTH_TOKEN=

# Override the agent's timezone before config load (config's agent.timezone is
# authoritative once loaded).
# TZ=America/Chicago
