{
  "name": "mikuswarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:native && tsc --noEmit",
    "build:native": "napi build --platform --manifest-path native/crates/matrix-core/Cargo.toml --js-package-name mikuswarm --output-dir npm",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.75.4",
    "@earendil-works/pi-ai": "0.75.4",
    "@sinclair/typebox": "0.34.49",
    "better-sqlite3": "12.10.0",
    "nanoid": "5.1.11",
    "sharp": "0.34.5",
    "smol-toml": "1.6.1",
    "tsx": "4.22.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.6.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
