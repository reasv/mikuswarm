# Base URL of the agent's in-process observability API (spec §8).
MIKUSWARM_CONSOLE_API_URL=http://127.0.0.1:8799

# Must match the agent's `observability.server.auth_token`. Leave unset if the
# agent has no token configured. This token lives ONLY on the BFF server and is
# never sent to the browser.
MIKUSWARM_CONSOLE_TOKEN=

# Bind the console's own (BFF) server to localhost in production (`pnpm start`).
HOST=127.0.0.1
PORT=5173
