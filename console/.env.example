# Base URL of the agent's in-process observability API (spec §8).
MIKUSWARM_CONSOLE_API_URL=http://127.0.0.1:8799

# Must match the agent's `observability.server.auth_token`. Leave unset if the
# agent has no token configured. This token lives ONLY on the BFF server and is
# never sent to the browser.
MIKUSWARM_CONSOLE_TOKEN=

# Demo mode (spec CONSOLE-DEMO-MODE). Set to 1 to render the real console UI against
# curated, non-sensitive FIXTURES instead of a live agent — for screenshots, demos, or
# frontend dev with no backend. Default off (unset/empty/0 = live). When on, the two
# vars above are ignored (there is no upstream to reach) and admin buttons are inert.
MIKUSWARM_CONSOLE_DEMO=

# Bind the console's own (BFF) server to localhost in production (`pnpm start`).
HOST=127.0.0.1
PORT=5173

# Public origin the console is served at, used by adapter-node to compute its own
# URL. MUST match the scheme+host+port you load in the browser. Without it,
# adapter-node defaults the protocol to `https`, so on plain-http access its
# computed origin (`https://127.0.0.1:5173`) won't match the browser's
# (`http://127.0.0.1:5173`). SvelteKit then 403s every mutating remote `command`
# (resume/abort/retry buttons) with "Cross-site remote requests are forbidden"
# while GET reads still work. Set this to your real URL (incl. https + real host
# if behind a TLS proxy, or use PROTOCOL_HEADER/HOST_HEADER instead).
ORIGIN=http://127.0.0.1:5173
